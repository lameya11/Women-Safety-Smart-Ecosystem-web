# SHE SAFE — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ══════════════════════════════════════════════════════════════════════════════
# FRONTEND (Vite — prefix VITE_ required; values are bundled into client JS)
# ══════════════════════════════════════════════════════════════════════════════

# ─── Backend API URL ──────────────────────────────────────────────────────────
# The URL of your deployed SafeGuard backend (no trailing slash).
# Example: https://safeguard-api.onrender.com
# Without this, the app falls back to localStorage-only mode.
VITE_API_URL=

# ─── App URL ──────────────────────────────────────────────────────────────────
VITE_APP_URL=https://safegaurd-women-safety.vercel.app

# ══════════════════════════════════════════════════════════════════════════════
# BACKEND (Node/Express — server-side only, never prefix with VITE_)
# ══════════════════════════════════════════════════════════════════════════════

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Required in production. Use a long random string (32+ chars).
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# ─── Firebase Firestore (optional — in-memory fallback if not set) ────────────
# Obtain service account from Firebase Console → Project Settings → Service Accounts
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ─── AI Backend — Priya (server-side only, NEVER use VITE_ prefix) ───────────
# Option A: OpenAI (GPT-3.5-turbo / GPT-4)
# Obtain from https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo

# Option B: Google Gemini
# Obtain from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Without either key, Priya uses the built-in offline safety knowledge base.
# Keys are NEVER forwarded to the browser.

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (in addition to *.vercel.app)
FRONTEND_URL=https://safegaurd-women-safety.vercel.app

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production
