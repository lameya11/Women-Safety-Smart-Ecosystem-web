# SHE SAFE — Environment Variables
# Copy this file to .env and fill in real values.
# Never commit .env to version control.

# ─── Google Maps (Safety Map screen) ───────────────────────────────────────────
# Obtain from https://console.cloud.google.com → Maps JavaScript API
# Without this key, the map shows a simulated placeholder view.
VITE_GOOGLE_MAPS_API_KEY=

# ─── Firebase (optional — for Google Sign-In and real-time sync) ───────────────
# Obtain from https://console.firebase.google.com → Project Settings → Web App
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ─── Twilio SMS (trusted contact alerts during SOS) ───────────────────────────
# Without this, contact notifications are queued locally only.
VITE_TWILIO_ACCOUNT_SID=
VITE_TWILIO_AUTH_TOKEN=
VITE_TWILIO_PHONE_NUMBER=

# ─── App configuration ────────────────────────────────────────────────────────
# Application base URL (used for sharing and PWA manifest)
VITE_APP_URL=https://safegaurd-women-safety.vercel.app
