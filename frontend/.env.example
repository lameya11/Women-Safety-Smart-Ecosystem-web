# Frontend Environment Variables
# Copy to .env.local and fill in your values

# Backend API URL - change to your deployed backend URL
REACT_APP_API_URL=http://localhost:5000/api

# Google Maps API Key (optional - app works with OpenStreetMap/Leaflet without this)
# Get from: https://console.cloud.google.com/
# REACT_APP_GOOGLE_MAPS_KEY=your-google-maps-api-key

# App name
REACT_APP_NAME=SafeGuard
REACT_APP_VERSION=1.0.0
